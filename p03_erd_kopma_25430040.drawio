        <mxCell id="t08dTrJENUwOb3vDXoqe-147" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontColor=light-dark(#000000,#F1E3E3);align=left;" value="&lt;b style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;Keterangan :&lt;/b&gt;&lt;br style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;&lt;span style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;PK = kunci primer &amp;nbsp;|&amp;nbsp; FK = kunci tamu &amp;nbsp;|&amp;nbsp; PK,FK = kunci primer komposit sekaligus kunci tamu&lt;/span&gt;&lt;br style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;&lt;span style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;1 = tepat satu &amp;nbsp;|&amp;nbsp; 0..1 = nol atau satu &amp;nbsp;|&amp;nbsp; 0..N = nol atau banyak &amp;nbsp;|&amp;nbsp; 1..N = satu atau banyak&lt;/span&gt;&lt;br style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;&lt;span style=&quot;font-size: 11px; white-space: nowrap;&quot;&gt;* = data pribadi (hanya ketua yang boleh melihat) &amp;nbsp;|&amp;nbsp; Atribut turunan (subtotal, total nota) dihitung, tidak disimpan&lt;/span&gt;" vertex="1">
